# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore all hidden files and directories, preserving required build files and directory keeps
.*
**/.*
!.ruby-version

# Ignore logfiles, tempfiles, and storage
*.log
log/*
tmp/*
storage/*
tmp/pids/*
tmp/storage/*

# Preserve required build files and directory keeps after the broad ignores above.
!log/.keep
!tmp/.keep
!storage/.keep
!tmp/pids/.keep
!tmp/storage/.keep

# Ignore development, CI, and Docker config/tooling
/*.json
/*.yml
/*.yaml
*.md
docs/
scratchpad/
justfile
Justfile
LICENSE
config/master.key
config/credentials/*.key
config/deploy*.yml
config/bundler-audit.yml
config/ci.rb
test/
/*.toml

# Ignore Docker files
.dockerignore
Dockerfile*
