#!/usr/bin/env ruby
# frozen_string_literal: true

app_root = File.expand_path("..", __dir__)
command_path = File.expand_path(ARGV.fetch(0), Dir.pwd)
runtime_command = %w[web jobs jobs-worker jobs-scheduler].any? { |name| command_path == File.join(app_root, "bin", name) } ||
  (command_path == File.join(app_root, "bin/rails") && ARGV[1] == "server")

rails_env = ENV.fetch("RAILS_ENV", "")
rails_env = "production" if rails_env.empty?

if rails_env == "production" && runtime_command && ENV.fetch("SECRET_KEY_BASE", "").empty?
  warn "Missing SECRET_KEY_BASE for production runtime"
  exit 1
end

# If running the rails server or jobs entrypoints then create or migrate existing database
if runtime_command && !system(File.join(app_root, "bin/rails"), "db:prepare", chdir: app_root)
  exit($?.exitstatus || 1)
end

begin
  exec([ARGV.fetch(0), ARGV.fetch(0)], *ARGV.drop(1))
rescue Errno::ENOENT
  warn "Command [#{ARGV.first}] is unavailable; check its path or update project dependencies and run just setup."
  exit 127
end
