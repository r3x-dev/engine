  def self.generate: (untyped object, ?untyped options) -> String
end

module Google
  module Apis
    class ServerError < StandardError
    end
    class RateLimitError < StandardError
    end
    class TransmissionError < StandardError
    end
    class RequestTimeOutError < StandardError
    end
    module GmailV1
      class Message
        def initialize: (?raw: String raw) -> void
      end

      class GmailService
        def authorization=: (untyped authorization) -> untyped
      end
    end

    module SheetsV4
      class SheetsService
        def authorization=: (untyped authorization) -> untyped
        def get_spreadsheet_values: (String spreadsheet_id, String range) -> untyped
      end
    end
  end
end

module Mail
  def self.new: () -> untyped

  class Part
    def self.new: () { (Mail::Part) -> untyped } -> Mail::Part
    def body: () -> untyped
    def body=: (String? body) -> untyped
    def content_type=: (String content_type) -> untyped
  end
end

module RubyLLM
  class RateLimitError < StandardError
  end
  class ServerError < StandardError
  end
  class ServiceUnavailableError < StandardError
  end
  class OverloadedError < StandardError
  end
  module Provider
    def self.providers: () -> Hash[Symbol, untyped]

    def self.register: (Symbol name, untyped provider) -> void
  end

  module Providers
    class OpenAI
    end
  end

  def self.context: () { (untyped config) -> untyped } -> untyped
  def self.configure: () { (untyped config) -> untyped } -> untyped
end

