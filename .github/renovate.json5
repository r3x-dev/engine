{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'github>zewelor/renovate-config//presets/ruby-version',
    'github>zewelor/renovate-config//presets/ruby-images',
  ],
  hostRules: [
    {
      hostType: 'docker',
      matchHost: 'https://dhi.io',
      username: '{{ secrets.DHI_USERNAME }}',
      password: '{{ secrets.DHI_TOKEN }}',
    },
  ],
  gitIgnoredAuthors: [
    'renovate-ruby-fix@users.noreply.github.com',
  ],
  labels: [
    'dependencies',
  ],
  timezone: 'Europe/Lisbon',
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: 'branch',
    automergeStrategy: 'squash',
  },
  packageRules: [
    {
      // .ruby-version owns Ruby upgrades; its workflow aligns the ARG and DHI image digests.
      // The native Dockerfile manager still refreshes the current tag's digest.
      description: 'Keep Ruby tag upgrades with the version-file workflow',
      matchManagers: [
        'dockerfile',
      ],
      matchPackageNames: [
        'docker.io/library/ruby',
        'dhi.io/ruby',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      enabled: false,
    },
    {
      description: 'Update in-range Bundler gems in Gemfile.lock',
      matchManagers: [
        'bundler',
      ],
      rangeStrategy: 'update-lockfile',
    },
    {
      description: 'Group non-major Bundler updates overnight',
      matchManagers: [
        'bundler',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'Ruby gems (non-major)',
      schedule: [
        '* 0-3 * * *',
      ],
    },
    {
      description: 'Auto-merge only patch updates for gems when tests pass',
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeStrategy: 'squash',
      matchPackageNames: [
        '*',
      ],
    },
    {
      description: 'Auto-merge minor updates when tests pass',
      matchUpdateTypes: [
        'minor',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeStrategy: 'squash',
      matchPackageNames: [
        '*',
      ],
    },
    {
      description: 'Major updates - PR only, no auto-merge',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      matchPackageNames: [
        '*',
      ],
    },
    {
      description: 'Auto-merge GitHub Actions updates when tests pass',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeStrategy: 'squash',
    },
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
}
