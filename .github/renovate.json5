{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  hostRules: [
    {
      hostType: 'docker',
      matchHost: 'https://dhi.io',
      username: '{{ secrets.DHI_USERNAME }}',
      password: '{{ secrets.DHI_TOKEN }}',
    },
  ],
  gitIgnoredAuthors: [
    'renovate-ruby-fix@users.noreply.github.com',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^Dockerfile$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: versioning=(?<versioning>[^\\s]+))?\\s+ARG [A-Z_]+=(?<currentValue>[^\\s]+)',
      ],
    },
  ],
  labels: [
    'dependencies',
  ],
  timezone: 'Europe/Lisbon',
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    automergeType: 'branch',
    automergeStrategy: 'squash',
  },
  packageRules: [
    {
      description: 'Pin DHI Ruby image digests',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'dhi.io/ruby',
      ],
      pinDigests: true,
    },
    {
      description: 'Auto-merge DHI Ruby image digest updates when tests pass',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'dhi.io/ruby',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
    },
    {
      // The Dockerfile ARG owns Ruby upgrades; its workflow aligns the DHI image digests.
      // The native Dockerfile manager still refreshes the current tag's digest.
      description: 'Keep Ruby tag upgrades with the Dockerfile version workflow',
      matchManagers: [
        'dockerfile',
      ],
      matchPackageNames: [
        'dhi.io/ruby',
      ],
      matchUpdateTypes: [
        'major',
        'minor',
        'patch',
      ],
      enabled: false,
    },
    {
      description: 'Update in-range Bundler gems in Gemfile.lock',
      matchManagers: [
        'bundler',
      ],
      rangeStrategy: 'update-lockfile',
    },
    {
      description: 'Group non-major Bundler updates overnight',
      matchManagers: [
        'bundler',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'Ruby gems (non-major)',
      schedule: [
        '* 0-3 * * *',
      ],
    },
    {
      description: 'Auto-merge patch and minor updates, including Ruby, when tests pass',
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeStrategy: 'squash',
    },
    {
      description: 'Keep PostgreSQL test images on major version 18',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'postgres',
      ],
      allowedVersions: '/^18(?:[.-]|$)/',
    },
    {
      description: 'Auto-merge PostgreSQL 18 Alpine digest updates when tests pass',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'postgres',
      ],
      matchCurrentValue: '18-alpine',
      matchUpdateTypes: [
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
    },
    {
      description: 'Major updates - PR only, no auto-merge',
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      matchPackageNames: [
        '*',
      ],
    },
    {
      description: 'Auto-merge GitHub Actions updates when tests pass',
      matchManagers: [
        'github-actions',
      ],
      automerge: true,
      automergeType: 'branch',
      automergeStrategy: 'squash',
    },
  ],
  prHourlyLimit: 0,
  prConcurrentLimit: 10,
}
